<?xml version="1.0"?>
<sdf version="1.6">
  <world name="conveyor_sorting">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>0.94 0.94 0.94 1</ambient><background>0.98 0.98 0.98 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 5 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 -0.4 -1</direction></light>

    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry><material><ambient>0.93 0.93 0.93 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material></visual>
    </link></model>

    <model name="work_surface"><static>true</static><pose>0.27 0.02 0.0225 0 0 0</pose><link name="body">
      <collision name="collision"><geometry><box><size>0.34 0.54 0.045</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.34 0.54 0.045</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
    </link></model>

    <model name="conveyor"><static>true</static><pose>0.26 0.155 0.052 0 0 0</pose><link name="body">
      <collision name="belt"><geometry><box><size>0.12 0.22 0.014</size></box></geometry></collision>
      <visual name="belt"><geometry><box><size>0.12 0.22 0.014</size></box></geometry><material><ambient>0.08 0.09 0.11 1</ambient><diffuse>0.12 0.13 0.16 1</diffuse></material></visual>
      <visual name="left_rail"><pose>-0.064 0 0.012 0 0 0</pose><geometry><box><size>0.008 0.23 0.024</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.70 0.72 0.75 1</diffuse></material></visual>
      <visual name="right_rail"><pose>0.064 0 0.012 0 0 0</pose><geometry><box><size>0.008 0.23 0.024</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.70 0.72 0.75 1</diffuse></material></visual>
      <visual name="roller_front"><pose>0 -0.110 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.12</length></cylinder></geometry><material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
      <visual name="roller_rear"><pose>0 0.110 0 1.5708 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.12</length></cylinder></geometry><material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
    </link></model>

    <!-- Three open sorting bins. -->
    <model name="sorting_bins"><static>true</static><pose>0 -0.12 0.047 0 0 0</pose><link name="body">
      <visual name="red_floor"><pose>0.19 0 0.002 0 0 0</pose><geometry><box><size>0.052 0.052 0.004</size></box></geometry><material><ambient>0.60 0.03 0.03 1</ambient><diffuse>0.90 0.08 0.08 1</diffuse></material></visual>
      <visual name="green_floor"><pose>0.26 0 0.002 0 0 0</pose><geometry><box><size>0.052 0.052 0.004</size></box></geometry><material><ambient>0.02 0.48 0.13 1</ambient><diffuse>0.05 0.78 0.22 1</diffuse></material></visual>
      <visual name="blue_floor"><pose>0.33 0 0.002 0 0 0</pose><geometry><box><size>0.052 0.052 0.004</size></box></geometry><material><ambient>0.02 0.18 0.62 1</ambient><diffuse>0.04 0.30 0.95 1</diffuse></material></visual>
      <collision name="floor"><pose>0.26 0 0.002 0 0 0</pose><geometry><box><size>0.192 0.056 0.004</size></box></geometry></collision>
      <collision name="back"><pose>0.26 0.030 0.015 0 0 0</pose><geometry><box><size>0.192 0.006 0.030</size></box></geometry></collision>
      <collision name="front"><pose>0.26 -0.030 0.015 0 0 0</pose><geometry><box><size>0.192 0.006 0.030</size></box></geometry></collision>
      <collision name="left"><pose>0.161 0 0.015 0 0 0</pose><geometry><box><size>0.006 0.066 0.030</size></box></geometry></collision>
      <collision name="divider1"><pose>0.225 0 0.015 0 0 0</pose><geometry><box><size>0.006 0.066 0.030</size></box></geometry></collision>
      <collision name="divider2"><pose>0.295 0 0.015 0 0 0</pose><geometry><box><size>0.006 0.066 0.030</size></box></geometry></collision>
      <collision name="right"><pose>0.359 0 0.015 0 0 0</pose><geometry><box><size>0.006 0.066 0.030</size></box></geometry></collision>
      <visual name="walls"><pose>0.26 0.030 0.015 0 0 0</pose><geometry><box><size>0.204 0.006 0.030</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
      <visual name="walls2"><pose>0.26 -0.030 0.015 0 0 0</pose><geometry><box><size>0.204 0.006 0.030</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
    </link></model>

    <model name="conveyor_cube_red"><static>false</static><pose>0.26 0.22 0.072 0 0 0</pose><link name="body"><inertial><mass>0.018</mass><inertia><ixx>1.9e-6</ixx><iyy>1.9e-6</iyy><izz>1.9e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry><material><ambient>0.85 0.02 0.02 1</ambient><diffuse>1 0.04 0.04 1</diffuse></material></visual></link></model>
    <model name="conveyor_cube_green"><static>false</static><pose>0.50 0.22 0.072 0 0 0</pose><link name="body"><inertial><mass>0.018</mass><inertia><ixx>1.9e-6</ixx><iyy>1.9e-6</iyy><izz>1.9e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry><material><ambient>0.01 0.75 0.10 1</ambient><diffuse>0.02 1 0.12 1</diffuse></material></visual></link></model>
    <model name="conveyor_cube_blue"><static>false</static><pose>0.50 0.18 0.072 0 0 0</pose><link name="body"><inertial><mass>0.018</mass><inertia><ixx>1.9e-6</ixx><iyy>1.9e-6</iyy><izz>1.9e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="collision"><geometry><box><size>0.025 0.025 0.025</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.025 0.025 0.025</size></box></geometry><material><ambient>0.01 0.12 0.90 1</ambient><diffuse>0.02 0.20 1 1</diffuse></material></visual></link></model>

    <model name="overhead_camera"><static>true</static><pose>0.26 0.155 0.55 0 1.5708 0</pose><link name="camera_link">
      <visual name="housing"><geometry><box><size>0.05 0.05 0.035</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      <sensor name="color_camera" type="camera"><always_on>true</always_on><update_rate>20</update_rate><camera><horizontal_fov>0.52</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>5</far></clip></camera>
        <plugin name="conveyor_camera" filename="libgazebo_ros_camera.so"><ros><namespace>/conveyor</namespace><remapping>image_raw:=camera/image_raw</remapping><remapping>camera_info:=camera/camera_info</remapping></ros><camera_name>overhead</camera_name><frame_name>overhead_camera</frame_name></plugin>
      </sensor>
    </link></model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>30.0</update_rate></plugin>
    <gui><camera name="user_camera"><pose>0.85 -0.85 0.70 0 0.45 2.35</pose></camera></gui>
  </world>
</sdf>
